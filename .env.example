# ApexBridge Backend Environment Configuration

PORT=5000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Connection URI (Mongoose)
# Place your MongoDB Atlas connection string here
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/apexbridge?retryWrites=true&w=majority

# Default Super Admin Credentials
ADMIN_EMAIL=admin@apexbridge.com
ADMIN_PASSWORD=AdminPassword123!
